{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Yarp": "Information"
    }
  },
  // In development the frontends are Vite dev servers. The BFF proxies them so the browser
  // only ever talks to one origin (the BFF), exactly like in Azure where the BFF serves the built files.
  "ReverseProxy": {
    "Routes": {
      "keystone-admin-spa": {
        "ClusterId": "keystone-admin",
        "Match": {
          "Path": "/admin/{**catch-all}"
        }
      },
      "keystone-spa": {
        "ClusterId": "keystone",
        "Order": 1000,
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "keystone": {
        "Destinations": {
          "vite": {
            "Address": "http://keystone"
          }
        }
      },
      "keystone-admin": {
        "Destinations": {
          "vite": {
            "Address": "http://keystone-admin"
          }
        }
      }
    }
  }
}
