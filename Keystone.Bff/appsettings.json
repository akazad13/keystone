{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Oidc": {
    // Authority, ClientId and ClientSecret are supplied by the AppHost (see docs/local-development.md).
    // urn:zitadel:iam:org:projects:roles asks Zitadel to include the user's project roles.
    "Scopes": [ "openid", "profile", "email", "offline_access", "urn:zitadel:iam:org:projects:roles" ]
  },
  "ReverseProxy": {
    "Routes": {
      "keystone-api": {
        "ClusterId": "core-api",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "keystone-api",
        "Match": {
          "Path": "/api/keystone/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/keystone" },
          { "PathPrefix": "/api" }
        ]
      },
      "keystone-admin-api": {
        "ClusterId": "core-api",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "keystone-admin-api",
        "Match": {
          "Path": "/api/keystone-admin/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/keystone-admin" },
          { "PathPrefix": "/api" }
        ]
      }
    },
    "Clusters": {
      "core-api": {
        "Destinations": {
          "primary": {
            "Address": "http://core-api"
          }
        }
      }
    }
  }
}
